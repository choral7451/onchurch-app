{
  "expo": {
    "name": "OnChurch",
    "slug": "onchurch-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "onchurch",
    "userInterfaceStyle": "light",
    "locales": {
      "ko": {
        "android": {
          "app_name": "온교회"
        }
      }
    },
    "ios": {
      "bundleIdentifier": "kr.co.everychurch.app",
      "supportsTablet": false,
      "appleTeamId": "D7RV3R6ALY",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ko",
        "CFBundleLocalizations": [
          "ko"
        ],
        "CFBundleDisplayName": "온교회",
        "NSCameraUsageDescription": "게시판에 올릴 사진을 촬영할 때 카메라를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "게시판에 올릴 사진을 고를 때 사진 보관함을 사용합니다.",
        "NSPhotoLibraryAddUsageDescription": "교회 사진을 기기에 저장할 때 사진 보관함을 사용합니다.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "kr.co.everychurch.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#17385F"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ],
    "owner": "ddoniel",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "acb35a4c-b0af-4f4b-a6b1-41c74144f586"
      }
    }
  }
}
